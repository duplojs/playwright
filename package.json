{
  "name": "@duplojs/playwright",
  "version": "0.0.0",
  "author": {
    "name": "mathcovax",
    "url": "https://github.com/mathcovax"
  },
  "contributors": [
    {
      "name": "zeriix",
      "url": "https://github.com/ZeRiix"
    }
  ],
  "homepage": "https://playwright.duplojs.dev/",
  "description": "A thin organizational layer over Playwright for structuring tests as Website/Page/Component hierarchies with readable, named actions.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duplojs/playwright.git"
  },
  "scripts": {
    "build": "./.commands/build.sh",
    "test:ut": "./.commands/test-ut.sh",
    "test:ut:watch": "./.commands/test-ut.sh --watch",
    "test:ut:update": "./.commands/test-ut.sh --update",
    "test:types": "./.commands/test-types.sh",
    "test:types:target": "./.commands/test-types-target.sh",
    "test:lint": "./.commands/test-lint.sh",
    "test:lint:fix": "./.commands/test-lint.sh --fix",
    "prepare": "husky",
    "docs:dev": "npm -w docs run docs:dev",
    "docs:build": "npm -w docs run docs:build",
    "docs:preview": "npm -w docs run docs:preview",
    "test:integration": "playwright test -c integrations/playwright.config.ts"
  },
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "@duplojs/lang": ">=v0.0.1-beta.8 <1.0.0",
    "playwright": ">=1.62.1 <2.0.0"
  },
  "devDependencies": {
    "@duplojs/code-config": "0.1.0",
    "@types/node": "24.1.0",
    "@typescript/typescript6": "6.0.2",
    "@vitest/coverage-istanbul": "4.1.10",
    "husky": "9.1.7",
    "rolldown": "1.2.4",
    "tscw-config": "1.1.2",
    "tslib": "2.8.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "unplugin-dts": "1.0.3",
    "vitest": "4.1.10"
  },
  "workspaces": [
    "integrations",
    "docs"
  ],
  "keywords": [
    "test",
    "playwright",
    "duplojs"
  ],
  "engines": {
    "node": ">=24.18.0"
  }
}
